@startuml
skin rose
allow_mixing
left to right direction

actor "Cliente final" as Cliente

cloud "Nuestra organización" as NuestraOrganizacion{
node "Nuestro producto" as NuestroProducto
actor QA
component "Nuestros sistemas" as NuestroSistema{
    component "Nuestro backend" as NuestroBackend
    actor BackDev
    BackDev . NuestroBackend : desarrolla
    
    component "Nuestro frontend" as NuestroFrontend
    actor FrontDev
    FrontDev . NuestroFrontend : desarrolla
   
    NuestroFrontend --> NuestroBackend : llama a
   
}
NuestroProducto <-- NuestroSistema : construyen
}

Cliente -- NuestroProducto : usa
QA -l- NuestroProducto : prueba

@enduml