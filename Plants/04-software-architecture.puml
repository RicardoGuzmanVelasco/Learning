@startuml Software Architecture Overview
skin rose
!define RECTANGLE class

package "Client Applications" {
  RECTANGLE "Web Browser" as WebBrowser {
    + React.js Frontend
    + JavaScript/TypeScript
    + HTML5/CSS3
  }
  
  RECTANGLE "Mobile App" as MobileApp {
    + React Native
    + iOS/Android
    + Native Modules
  }
  
  RECTANGLE "Desktop App" as DesktopApp {
    + Electron
    + Cross-platform
    + Native APIs
  }
}

package "API Gateway & Load Balancer" {
  RECTANGLE "API Gateway" as APIGateway {
    + Route Management
    + Authentication
    + Rate Limiting
    + Request Validation
  }
  
  RECTANGLE "Load Balancer" as LoadBalancer {
    + Traffic Distribution
    + Health Checks
    + SSL Termination
  }
}

package "Microservices Architecture" {
  package "User Service" {
    RECTANGLE "User API" as UserAPI {
      + REST Endpoints
      + GraphQL
      + Authentication
    }
    
    RECTANGLE "User Business Logic" as UserLogic {
      + User Management
      + Profile Services
      + Validation Rules
    }
    
    RECTANGLE "User Database" as UserDB {
      + PostgreSQL
      + User Tables
      + Indexes
    }
  }
  
  package "Product Service" {
    RECTANGLE "Product API" as ProductAPI {
      + REST Endpoints
      + Search APIs
      + Catalog Management
    }
    
    RECTANGLE "Product Business Logic" as ProductLogic {
      + Inventory Management
      + Pricing Logic
      + Category Management
    }
    
    RECTANGLE "Product Database" as ProductDB {
      + MongoDB
      + Product Collections
      + Search Indexes
    }
  }
  
  package "Order Service" {
    RECTANGLE "Order API" as OrderAPI {
      + Order Processing
      + Payment Integration
      + Status Tracking
    }
    
    RECTANGLE "Order Business Logic" as OrderLogic {
      + Order Workflow
      + Business Rules
      + Validation
    }
    
    RECTANGLE "Order Database" as OrderDB {
      + PostgreSQL
      + Order Tables
      + Transaction Logs
    }
  }
}

package "Shared Infrastructure" {
  package "Message Queue" {
    RECTANGLE "Event Bus" as EventBus {
      + Apache Kafka
      + Event Streaming
      + Message Persistence
    }
    
    RECTANGLE "Task Queue" as TaskQueue {
      + Redis Queue
      + Background Jobs
      + Scheduled Tasks
    }
  }
  
  package "Caching Layer" {
    RECTANGLE "Application Cache" as AppCache {
      + Redis
      + Session Storage
      + Query Caching
    }
    
    RECTANGLE "CDN" as CDN {
      + Static Assets
      + Global Distribution
      + Edge Caching
    }
  }
  
  package "External Services" {
    RECTANGLE "Payment Gateway" as PaymentGateway {
      + Stripe/PayPal
      + Payment Processing
      + Webhooks
    }
    
    RECTANGLE "Email Service" as EmailService {
      + SendGrid/AWS SES
      + Transactional Emails
      + Marketing Campaigns
    }
    
    RECTANGLE "File Storage" as FileStorage {
      + AWS S3
      + Image/Document Storage
      + CDN Integration
    }
  }
}

package "DevOps & Monitoring" {
  RECTANGLE "Container Orchestration" as K8s {
    + Kubernetes
    + Docker Containers
    + Auto-scaling
  }
  
  RECTANGLE "Monitoring & Logging" as Monitoring {
    + Prometheus/Grafana
    + ELK Stack
    + Distributed Tracing
  }
  
  RECTANGLE "CI/CD Pipeline" as CICD {
    + GitHub Actions
    + Automated Testing
    + Deployment Automation
  }
}

' Client connections
WebBrowser --> LoadBalancer : HTTPS
MobileApp --> LoadBalancer : HTTPS
DesktopApp --> LoadBalancer : HTTPS

' Gateway routing
LoadBalancer --> APIGateway
APIGateway --> UserAPI
APIGateway --> ProductAPI
APIGateway --> OrderAPI

' Service internal connections
UserAPI --> UserLogic
UserLogic --> UserDB
ProductAPI --> ProductLogic
ProductLogic --> ProductDB
OrderAPI --> OrderLogic
OrderLogic --> OrderDB

' Inter-service communication
UserLogic ..> EventBus : publishes events
ProductLogic ..> EventBus : publishes events
OrderLogic ..> EventBus : publishes events
OrderLogic ..> UserAPI : REST calls
OrderLogic ..> ProductAPI : REST calls

' Infrastructure connections
UserLogic --> AppCache : caching
ProductLogic --> AppCache : caching
OrderLogic --> AppCache : caching
OrderLogic --> PaymentGateway : payment processing
UserLogic --> EmailService : notifications
ProductLogic --> FileStorage : asset storage

' Background processing
EventBus --> TaskQueue : async processing
TaskQueue --> UserLogic : background jobs
TaskQueue --> OrderLogic : background jobs

' Monitoring
K8s --> Monitoring : metrics & logs
UserAPI --> Monitoring : application metrics
ProductAPI --> Monitoring : application metrics
OrderAPI --> Monitoring : application metrics

note right of "Microservices Architecture" : Each service is independently\ndeployable and scalable
note right of "Message Queue" : Enables loose coupling\nbetween services
note right of "DevOps & Monitoring" : Ensures reliability\nand observability

@enduml
