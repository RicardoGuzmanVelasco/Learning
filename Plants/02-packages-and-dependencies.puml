@startuml Package Organization and Dependencies
skin rose

package "Presentation Layer" {
  package WebAPI {
    class UserController {
      + getUser(id: String): UserDto
      + createUser(userData: CreateUserRequest): UserDto
      + updateUser(id: String, userData: UpdateUserRequest): UserDto
    }
    
    class ProductController {
      + getProducts(): List<ProductDto>
      + getProduct(id: String): ProductDto
      + createProduct(productData: CreateProductRequest): ProductDto
    }
  }
  
  package DTOs {
    class UserDto {
      + String id
      + String name
      + String email
      + Date createdAt
    }
    
    class ProductDto {
      + String id
      + String name
      + float price
      + String category
    }
  }
}

package "Business Logic Layer" {
  package Services {
    interface IUserService {
      + User getUser(id: String)
      + User createUser(userData: User)
      + User updateUser(id: String, userData: User)
    }
    
    class UserService implements IUserService {
      - IUserRepository userRepository
      - IEmailService emailService
      + User getUser(id: String)
      + User createUser(userData: User)
      + User updateUser(id: String, userData: User)
    }
    
    interface IProductService {
      + List<Product> getProducts()
      + Product getProduct(id: String)
      + Product createProduct(productData: Product)
    }
    
    class ProductService implements IProductService {
      - IProductRepository productRepository
      - IPricingService pricingService
    }
  }
  
  package Domain {
    class User {
      - String id
      - String name
      - String email
      - Date createdAt
      + validateEmail(): boolean
      + updateProfile(name: String, email: String): void
    }
    
    class Product {
      - String id
      - String name
      - Money price
      - Category category
      + applyDiscount(percentage: float): void
      + isAvailable(): boolean
    }
    
    enum Category {
      ELECTRONICS
      CLOTHING
      BOOKS
      HOME_GARDEN
    }
  }
}

package "Data Access Layer" {
  package Repositories {
    interface IUserRepository {
      + User findById(id: String)
      + User save(user: User)
      + void delete(id: String)
    }
    
    class DatabaseUserRepository implements IUserRepository {
      - DatabaseConnection connection
      + User findById(id: String)
      + User save(user: User)
      + void delete(id: String)
    }
    
    interface IProductRepository {
      + List<Product> findAll()
      + Product findById(id: String)
      + Product save(product: Product)
    }
    
    class DatabaseProductRepository implements IProductRepository {
      - DatabaseConnection connection
    }
  }
}

package "Infrastructure" {
  package External {
    interface IEmailService {
      + void sendEmail(to: String, subject: String, body: String)
    }
    
    class SmtpEmailService implements IEmailService {
      - String smtpServer
      - int port
      + void sendEmail(to: String, subject: String, body: String)
    }
    
    interface IPricingService {
      + Money calculatePrice(Product product, User user)
    }
    
    class DynamicPricingService implements IPricingService {
      - List<PricingRule> rules
    }
  }
}

' Dependencies (shown with dashed arrows)
WebAPI ..> Services : uses
WebAPI ..> DTOs : uses
Services ..> Domain : uses
Services ..> Repositories : uses
Services ..> External : uses
Repositories ..> Domain : uses

@enduml
