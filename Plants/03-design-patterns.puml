@startuml Design Patterns
skin rose

package "Behavioral Patterns" {
  package Observer {
    interface IObserver {
      + update(data: Object): void
    }
    
    class ConcreteObserver implements IObserver {
      - String name
      + update(data: Object): void
    }
    
    abstract class Subject {
      - List<IObserver> observers
      + attach(observer: IObserver): void
      + detach(observer: IObserver): void
      # notify(): void
    }
    
    class WeatherStation extends Subject {
      - float temperature
      - float humidity
      + setWeatherData(temp: float, humidity: float): void
    }
  }
  
  package Strategy {
    interface IPaymentStrategy {
      + processPayment(amount: Money): boolean
    }
    
    class CreditCardPayment implements IPaymentStrategy {
      - String cardNumber
      - String cvv
      + processPayment(amount: Money): boolean
    }
    
    class PayPalPayment implements IPaymentStrategy {
      - String email
      - String password
      + processPayment(amount: Money): boolean
    }
    
    class PaymentProcessor {
      - IPaymentStrategy strategy
      + setPaymentStrategy(strategy: IPaymentStrategy): void
      + executePayment(amount: Money): boolean
    }
  }
}

package "Creational Patterns" {
  package Factory {
    interface IDocument {
      + open(): void
      + save(): void
      + close(): void
    }
    
    class WordDocument implements IDocument {
      + open(): void
      + save(): void
      + close(): void
    }
    
    class PDFDocument implements IDocument {
      + open(): void
      + save(): void
      + close(): void
    }
    
    abstract class DocumentFactory {
      {abstract} + createDocument(): IDocument
    }
    
    class WordDocumentFactory extends DocumentFactory {
      + createDocument(): IDocument
    }
    
    class PDFDocumentFactory extends DocumentFactory {
      + createDocument(): IDocument
    }
  }
  
  package Singleton {
    class DatabaseConnection {
      - static DatabaseConnection instance
      - String connectionString
      - DatabaseConnection()
      + static getInstance(): DatabaseConnection
      + connect(): void
      + disconnect(): void
    }
    
    class Logger {
      - static Logger instance
      - List<String> logs
      - Logger()
      + static getInstance(): Logger
      + log(message: String): void
      + getLogs(): List<String>
    }
  }
}

package "Structural Patterns" {
  package Adapter {
    interface IMediaPlayer {
      + play(audioType: String, fileName: String): void
    }
    
    class AudioPlayer implements IMediaPlayer {
      - MediaAdapter adapter
      + play(audioType: String, fileName: String): void
    }
    
    interface IAdvancedMediaPlayer {
      + playVlc(fileName: String): void
      + playMp4(fileName: String): void
    }
    
    class VlcPlayer implements IAdvancedMediaPlayer {
      + playVlc(fileName: String): void
      + playMp4(fileName: String): void
    }
    
    class MediaAdapter implements IMediaPlayer {
      - IAdvancedMediaPlayer advancedPlayer
      + MediaAdapter(audioType: String)
      + play(audioType: String, fileName: String): void
    }
  }
  
  package Decorator {
    interface ICoffee {
      + getDescription(): String
      + getCost(): float
    }
    
    class SimpleCoffee implements ICoffee {
      + getDescription(): String
      + getCost(): float
    }
    
    abstract class CoffeeDecorator implements ICoffee {
      # ICoffee coffee
      + CoffeeDecorator(coffee: ICoffee)
    }
    
    class MilkDecorator extends CoffeeDecorator {
      + getDescription(): String
      + getCost(): float
    }
    
    class SugarDecorator extends CoffeeDecorator {
      + getDescription(): String
      + getCost(): float
    }
  }
}

' Pattern relationships
Subject o-- IObserver : notifies
PaymentProcessor --> IPaymentStrategy : uses
DocumentFactory ..> IDocument : creates
AudioPlayer --> MediaAdapter : uses
CoffeeDecorator --> ICoffee : wraps

@enduml
